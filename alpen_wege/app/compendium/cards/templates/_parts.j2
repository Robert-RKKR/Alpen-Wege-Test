{#- Parts shared by every card style (imported with: {% import "_parts.j2" as parts %}). Not a style itself: render.STYLES does not list it. -#}

{#- Stat chip icons, outlines in a 24 x 24 box; the caller sets stroke, stroke-width and the scale.
    Each drawing is centred on the middle of the box (12, 12), so the three icons line up with the label next to them.
    type = price tag, altitude = mountain with snow line, difficulty = gauge. An unknown key draws nothing. -#}
{%- macro icon(key) -%}
  {%- if key == 'type' -%}
  <path d="M3.5 3.5h8l9 9-8 8-9-9z"/><circle cx="8" cy="8" r="1.4"/>
  {%- elif key == 'altitude' -%}
  <path d="M2 18.3L9 5.8l4 6.5 2.5-3.5L22 18.3z"/><path d="M6.8 9.8l2.2 1.6 1.6-1.4"/>
  {%- elif key == 'difficulty' -%}
  <path d="M3.5 16a8.5 8.5 0 1 1 17 0"/><path d="M12 16l4.2-6"/><circle cx="12" cy="16" r="1.3"/>
  {%- endif -%}
{%- endmacro -%}

{#- Map pin, 16 x 22 box, for the location line. -#}
{%- macro pin_path() -%}M8 0C3.6 0 0 3.5 0 7.9 0 13.8 8 22 8 22S16 13.8 16 7.9C16 3.5 12.4 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z{%- endmacro -%}
