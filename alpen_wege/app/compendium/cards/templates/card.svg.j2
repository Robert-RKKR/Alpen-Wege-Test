{#- Collectible card. Trim 63x88 mm + 3 mm bleed; 10 user units = 1 mm. Every text value is auto-escaped. -#}
{%- set W, H, B = 630, 880, 30 -%}
{%- set c = rarity.color -%}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ (W + 2*B) / 10 }}mm" height="{{ (H + 2*B) / 10 }}mm" viewBox="{{ -B }} {{ -B }} {{ W + 2*B }} {{ H + 2*B }}"
     font-family="{{ font }}">
  <title>{{ number_label }} {{ name }}</title>
  <defs>
    <clipPath id="card"><rect width="{{ W }}" height="{{ H }}" rx="30"/></clipPath>
    <clipPath id="photo"><rect x="18" y="18" width="{{ W - 36 }}" height="{{ L.photo_h }}" rx="20"/></clipPath>
    <clipPath id="flag"><circle r="20"/></clipPath>
    <radialGradient id="glow" cx="50%" cy="0%" r="90%">
      <stop offset="0" stop-color="{{ c }}" stop-opacity="0.35"/>
      <stop offset="1" stop-color="{{ c }}" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B0F14" stop-opacity="0.55"/>
      <stop offset="0.22" stop-color="#0B0F14" stop-opacity="0"/>
      <stop offset="0.55" stop-color="#0B0F14" stop-opacity="0"/>
      <stop offset="1" stop-color="#0B0F14" stop-opacity="0.92"/>
    </linearGradient>
    <linearGradient id="frame" x1="0" y1="0" x2="1" y2="1">
      {%- if rarity.foil %}
      <stop offset="0" stop-color="#FFE29A"/><stop offset="0.25" stop-color="{{ c }}"/>
      <stop offset="0.5" stop-color="#9BE7FF"/><stop offset="0.75" stop-color="#F5A8FF"/>
      <stop offset="1" stop-color="{{ c }}"/>
      {%- else %}
      <stop offset="0" stop-color="{{ c }}"/><stop offset="0.5" stop-color="{{ c }}" stop-opacity="0.55"/>
      <stop offset="1" stop-color="{{ c }}"/>
      {%- endif %}
    </linearGradient>
    <linearGradient id="nophoto" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{{ c }}" stop-opacity="0.55"/><stop offset="1" stop-color="#1A2230"/>
    </linearGradient>
  </defs>

  {#- bleed: plain card colour runs past the cut line #}
  <rect x="{{ -B }}" y="{{ -B }}" width="{{ W + 2*B }}" height="{{ H + 2*B }}" fill="#0F141B"/>

  <g clip-path="url(#card)">
    <rect width="{{ W }}" height="{{ H }}" fill="#0F141B"/>
    <rect width="{{ W }}" height="{{ H }}" fill="url(#glow)"/>

    {#- ---------- photo ---------- #}
    <g clip-path="url(#photo)">
      {%- if photo_href %}
      <image x="18" y="18" width="{{ W - 36 }}" height="{{ L.photo_h }}" preserveAspectRatio="xMidYMid slice" xlink:href="{{ photo_href }}"/>
      {%- else %}
      <rect x="18" y="18" width="{{ W - 36 }}" height="{{ L.photo_h }}" fill="url(#nophoto)"/>
      <path d="M18 {{ 18 + L.photo_h }} L170 250 L240 320 L360 160 L470 300 L520 250 L{{ W - 18 }} 330 V{{ 18 + L.photo_h }} Z" fill="#0F141B" opacity="0.45"/>
      {%- endif %}
      <rect x="18" y="18" width="{{ W - 36 }}" height="{{ L.photo_h }}" fill="url(#shade)"/>
    </g>

    {#- number pill #}
    <g transform="translate(40 40)">
      <rect width="{{ L.pill_w }}" height="40" rx="20" fill="#0B0F14" fill-opacity="0.55" stroke="#FFFFFF" stroke-opacity="0.25"/>
      <text x="{{ L.pill_w / 2 }}" y="27" text-anchor="middle" font-size="20" font-weight="700" letter-spacing="1.5" fill="#FFFFFF">{{ number_label }}</text>
    </g>

    {#- flags: overlapping round badges, the first (main region) country on top #}
    {%- for f in flags | reverse %}
    <g transform="translate({{ W - 62 - (flags|length - loop.index) * 34 }} 60)">
      <circle r="22" fill="#0B0F14" stroke="#FFFFFF" stroke-width="3"/>
      {%- if f.href %}
      <image x="-20" y="-20" width="40" height="40" clip-path="url(#flag)" preserveAspectRatio="xMidYMid slice" xlink:href="{{ f.href }}"/>
      {%- else %}
      <text y="6" text-anchor="middle" font-size="15" font-weight="700" fill="#FFFFFF">{{ f.iso }}</text>
      {%- endif %}
    </g>
    {%- endfor %}

    {#- name + location on the photo #}
    {%- for line in L.name_lines %}
    <text x="44" y="{{ L.name_y + loop.index0 * L.name_lh }}" font-size="{{ L.name_size }}" font-weight="700" letter-spacing="-0.5" fill="#FFFFFF">{{ line }}</text>
    {%- endfor %}
    <g transform="translate(44 {{ L.loc_y }})">
      <path d="M8 0C3.6 0 0 3.5 0 7.9 0 13.8 8 22 8 22S16 13.8 16 7.9C16 3.5 12.4 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" transform="translate(0 -17)" fill="{{ c }}"/>
      <text x="26" y="0" font-size="{{ L.loc_size }}" fill="#FFFFFF" fill-opacity="0.85">{{ L.location }}</text>
    </g>

    {#- ---------- stat chips ---------- #}
    {%- for s in stats %}
    <g transform="translate({{ s.x }} {{ L.stats_y }})">
      <rect width="{{ s.w }}" height="74" rx="16" fill="#FFFFFF" fill-opacity="0.06" stroke="#FFFFFF" stroke-opacity="0.08"/>
      {%- if s.color %}<rect x="0" y="16" width="5" height="42" rx="2.5" fill="{{ s.color }}"/>{% endif %}
      <text x="18" y="28" font-size="13" font-weight="700" letter-spacing="1.6" fill="#FFFFFF" fill-opacity="0.55">{{ s.label | upper }}</text>
      <text x="18" y="58" font-size="{{ s.size }}" font-weight="700" fill="{{ s.color or '#FFFFFF' }}">{{ s.value }}</text>
    </g>
    {%- endfor %}

    {#- ---------- description ---------- #}
    <rect x="18" y="{{ L.desc_y }}" width="{{ W - 36 }}" height="{{ L.desc_h }}" rx="18" fill="#FFFFFF" fill-opacity="0.035"/>
    <text font-size="{{ L.desc_size }}" fill="#E7ECF2" fill-opacity="0.92">
      {%- for line in L.desc_lines %}
      <tspan x="40" y="{{ L.desc_y + 36 + loop.index0 * L.desc_lh }}">{{ line }}</tspan>
      {%- endfor %}
    </text>

    {#- ---------- footer ---------- #}
    <g transform="translate(40 {{ H - 40 }})">
      <path d="M0 -10 L10 0 L0 10 L-10 0 Z" transform="translate(10 -6)" fill="{{ c }}"/>
      <text x="30" y="0" font-size="16" font-weight="700" letter-spacing="3" fill="{{ c }}">{{ rarity.name | upper }}</text>
    </g>
    <text x="{{ W - 40 }}" y="{{ H - 40 }}" text-anchor="end" font-size="14" fill="#FFFFFF" fill-opacity="0.45">{{ footer }}</text>
  </g>

  {#- rarity frame on top of everything #}
  <rect x="4" y="4" width="{{ W - 8 }}" height="{{ H - 8 }}" rx="27" fill="none" stroke="url(#frame)" stroke-width="8"/>
  <rect x="11" y="11" width="{{ W - 22 }}" height="{{ H - 22 }}" rx="22" fill="none" stroke="#FFFFFF" stroke-opacity="0.12" stroke-width="1.5"/>
</svg>
